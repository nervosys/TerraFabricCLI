  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Search the TerraFabric catalog of open, commercial and government-channel geospatial intelligence sources: Earth observation (raw to finished products), aircraft and vessel tracks, RF, cellular and network data, weather and forecasts, mobility and events, infrastructure, industry, energy, minerals, AI and the defense industrial base, trade, logistics, capital flows and markets. Supports free text with operational synonyms (e.g. 'radar', 'ship', 'methane'), facets and spatial/temporal filters. access=restricted lists government-only sources (discoverable, never orderable). Returns ranked collections with facet counts.",
    "inputSchema": {
      "properties": {
        "access": {
          "enum": [
            "free",
            "commercial",
            "restricted"
          ],
          "type": "string"
        },
        "all_weather": {
          "type": "boolean"
        },
        "bbox": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "datetime": {
          "description": "ISO interval 'start/end'; '..' for open ends.",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "max_gsd": {
          "description": "Max ground sample distance in metres.",
          "type": "number"
        },
        "modality": {
          "items": {
            "enum": [
              "optical",
              "multispectral",
              "hyperspectral",
              "thermal",
              "sar",
              "lidar",
