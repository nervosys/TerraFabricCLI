              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "object"
            }
          ]
        },
        "collection": {
          "type": "string"
        },
        "datetime": {
          "type": "string"
        },
        "license_tier": {
          "enum": [
            "single-org",
            "multi-org",
            "government-wide",
            "public-release"
          ],
          "type": "string"
        },
        "mode": {
          "enum": [
            "archive",
            "tasking",
            "subscription"
          ],
          "type": "string"
        },
        "months": {
          "maximum": 36,
          "minimum": 1,
          "type": "integer"
        },
        "priority": {
          "enum": [
            "standard",
            "priority",
            "urgent",
            "flash"
          ],
          "type": "string"
        }
      },
