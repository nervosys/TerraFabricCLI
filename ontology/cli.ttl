<https://terrafabric.world/id/cli/tfab/command/graph-match> a tf:RemoteCliCommand ;
    schema:description "Linked-data-fragments style triple pattern query over the full knowledge graph (ontology + catalog). Any of s/p/o may be omitted as a wildcard. Use CURIEs (tf:, tfr:, dct:, ...). Literal objects match by value." ;
