<https://terrafabric.world/id/cli/tfab/command/items-search> a tf:RemoteCliCommand ;
    schema:description "Find STAC items (scenes/granules) for a collection over a bbox and time interval. Open collections are searched live against their upstream STAC APIs (tf:source.kind = live, each item links to its upstream record); commercial collections, or open ones whose upstream is unavailable, return simulated items flagged tf:synthetic." ;
    schema:encodingType "application/json" ;
    schema:name "Search items (scenes)" ;
    tf:commandLine "tfab items search" ;
    tf:example "tfab items search --collection sentinel-2-l2a --bbox 4.0,51.9,4.3,52.0 --datetime 2026-09-01/.. --max-cloud 20" ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/items-search/option/collection> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/items-search/option/bbox> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/items-search/option/datetime> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/items-search/option/limit> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/items-search/option/max-cloud> ;
    tf:hasSideEffect tf:effect-read-only ;
    tf:idempotent true ;
    tf:inCommandGroup <https://terrafabric.world/id/cli/tfab/group/items> ;
    tf:inputSchema "{\"properties\":{\"bbox\":{\"items\":{\"type\":\"number\"},\"maxItems\":4,\"minItems\":4,\"type\":\"array\"},\"collection\":{\"type\":\"string\"},\"datetime\":{\"type\":\"string\"},\"limit\":{\"default\":10,\"maximum\":100,\"minimum\":1,\"type\":\"integer\"},\"max_cloud\":{\"maximum\":100,\"minimum\":0,\"type\":\"number\"}},\"required\":[\"collection\"],\"type\":\"object\"}"^^rdf:JSON ;
    tf:invokesTool <https://terrafabric.world/id/tool/search_items> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/ok> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/internal> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/usage> ;
