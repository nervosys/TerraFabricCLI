@prefix tf: <https://terrafabric.world/ont#> .
@prefix tfr: <https://terrafabric.world/id/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

<https://terrafabric.world/ont/cli> a owl:Ontology ;
    dct:description "Describes command-line programs for agents: commands, their inputs, side effects, required credentials, results and exit statuses, linked to the TerraFabric ontology's tools and classes." ;
    dct:title "TerraFabric CLI Ontology" ;
    owl:imports <https://terrafabric.world/ont> ;
    owl:versionInfo "0.1.2" .

tf:CliCommand a owl:Class ;
    rdfs:comment "One invocable command line. Its inputs are tf:CliOption values; running it has one tf:SideEffect." ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "CLI command" ;
    rdfs:subClassOf schema:EntryPoint ;
    tf:module "cli" .

tf:CliCommandGroup a owl:Class ;
    rdfs:comment "A named set of related subcommands (the first word after the program name)." ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "Command group" ;
    rdfs:subClassOf skos:Collection ;
    tf:module "cli" .

tf:CliOption a owl:Class ;
    rdfs:comment "A named input of a command, given as --flag VALUE. Maps to one key of the command's JSON input." ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "CLI option" ;
    rdfs:subClassOf schema:PropertyValueSpecification ;
    tf:module "cli" .

tf:CommandLineProgram a owl:Class ;
    rdfs:comment "An executable with subcommands that agents and people invoke from a shell." ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "Command-line program" ;
    rdfs:subClassOf schema:SoftwareApplication ;
    tf:module "cli" .

tf:CredentialRequirement a owl:Class ;
    rdfs:comment "The credential a command needs." ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "Credential requirement" ;
    rdfs:subClassOf skos:Concept ;
    tf:module "cli" .

tf:CredentialScheme a skos:ConceptScheme ;
    skos:prefLabel "Credential requirements" .

tf:EnvironmentVariable a owl:Class ;
    rdfs:comment "A process environment variable the program reads." ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "Environment variable" ;
    tf:module "cli" .

tf:ExitStatus a owl:Class ;
    rdfs:comment "A process exit code with a stable meaning agents can branch on." ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "Exit status" ;
    tf:module "cli" .

tf:GlobalOption a owl:Class ;
    rdfs:comment "An option every command accepts." ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "Global option" ;
    rdfs:subClassOf tf:CliOption ;
    tf:module "cli" .

tf:LocalCliCommand a owl:Class ;
    rdfs:comment "A command implemented by the program itself (description, ontology, configuration, MCP serving)." ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "Local CLI command" ;
    rdfs:subClassOf tf:CliCommand ;
    tf:module "cli" .

tf:OutputFormat a owl:Class ;
    rdfs:comment "A serialisation of command results on stdout." ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "Output format" ;
    rdfs:subClassOf skos:Concept ;
    tf:module "cli" .

tf:OutputFormatScheme a skos:ConceptScheme ;
    skos:prefLabel "Output formats" .

tf:RemoteCliCommand a owl:Class ;
    rdfs:comment "A command that invokes a TerraFabric server tool (tf:Tool) over HTTPS." ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "Remote CLI command" ;
    rdfs:subClassOf tf:CliCommand ;
    tf:module "cli" .

tf:SideEffect a owl:Class ;
    rdfs:comment "What running a command changes, from nothing to committed spend." ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "Side effect" ;
    rdfs:subClassOf skos:Concept ;
    tf:module "cli" .

tf:SideEffectScheme a skos:ConceptScheme ;
    skos:prefLabel "Side effects" .

tf:allowedValue a owl:DatatypeProperty ;
    rdfs:comment "One permitted value of an enumerated option." ;
    rdfs:domain tf:CliOption ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "allowed value" ;
    rdfs:range xsd:string ;
    tf:module "cli" .

tf:argumentKey a owl:DatatypeProperty ;
    rdfs:comment "The key the option sets in the JSON input sent to the tool." ;
    rdfs:domain tf:CliOption ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "argument key" ;
    rdfs:range xsd:string ;
    tf:module "cli" .

tf:commandLine a owl:DatatypeProperty ;
    rdfs:comment "The words that invoke the command, e.g. 'tfab collections search'." ;
    rdfs:domain tf:CliCommand ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "command line" ;
    rdfs:range xsd:string ;
    tf:module "cli" .

tf:credential-agent-identity a tf:CredentialRequirement ;
    skos:definition "Acts for an agent identity (--agent-id or TFAB_AGENT_ID); spend is bounded by that agent's mandate." ;
    skos:inScheme tf:CredentialScheme ;
    skos:prefLabel "Agent identity" .

tf:credential-mission-read a tf:CredentialRequirement ;
    skos:definition "Mission API bearer credential with the read scope (TFAB_TOKEN, or OAuth client credentials)." ;
    skos:inScheme tf:CredentialScheme ;
    skos:prefLabel "Mission API, read scope" .

tf:credential-mission-task a tf:CredentialRequirement ;
    skos:definition "Mission API bearer credential with the task scope (TFAB_TOKEN, or OAuth client credentials)." ;
    skos:inScheme tf:CredentialScheme ;
    skos:prefLabel "Mission API, task scope" .

tf:credential-none a tf:CredentialRequirement ;
    skos:definition "Public; no credential is sent." ;
    skos:inScheme tf:CredentialScheme ;
    skos:prefLabel "No credential" .

tf:credential-principal a tf:CredentialRequirement ;
    skos:definition "Needs the principal token issued with the agent's mandate. Only the human principal holds it; an agent must never supply its own." ;
    skos:inScheme tf:CredentialScheme ;
    skos:prefLabel "Principal token" .

tf:effect-commits-spend a tf:SideEffect ;
    skos:definition "Commits money or tasks a sensor; the CLI refuses to run it without --yes." ;
    skos:inScheme tf:SideEffectScheme ;
    skos:prefLabel "Commits spend" .

tf:effect-creates-state a tf:SideEffect ;
    skos:definition "Creates or updates server-side state but commits no spend." ;
    skos:inScheme tf:SideEffectScheme ;
    skos:prefLabel "Creates state" .

tf:effect-local a tf:SideEffect ;
    skos:definition "Runs on the local machine without contacting the server." ;
    skos:inScheme tf:SideEffectScheme ;
    skos:prefLabel "Local only" .

tf:effect-read-only a tf:SideEffect ;
    skos:definition "Reads data and changes nothing; safe to retry or run speculatively." ;
    skos:inScheme tf:SideEffectScheme ;
    skos:prefLabel "Read only" .

tf:envName a owl:DatatypeProperty ;
    rdfs:comment "The variable's name." ;
    rdfs:domain tf:EnvironmentVariable ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "environment variable name" ;
    rdfs:range xsd:string ;
    tf:module "cli" .

tf:example a owl:DatatypeProperty ;
    rdfs:comment "A complete, runnable example invocation." ;
    rdfs:domain tf:CliCommand ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "example" ;
    rdfs:range xsd:string ;
    tf:module "cli" .

tf:exitCode a owl:DatatypeProperty ;
    rdfs:comment "The numeric process exit code." ;
    rdfs:domain tf:ExitStatus ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "exit code" ;
    rdfs:range xsd:integer ;
    tf:module "cli" .

tf:hasCommand a owl:ObjectProperty ;
    rdfs:comment "A command the program offers." ;
    rdfs:domain tf:CommandLineProgram ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "has command" ;
    rdfs:range tf:CliCommand ;
    tf:module "cli" .

tf:hasCommandGroup a owl:ObjectProperty ;
    rdfs:comment "A command group of the program." ;
    rdfs:domain tf:CommandLineProgram ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "has command group" ;
    rdfs:range tf:CliCommandGroup ;
    tf:module "cli" .

tf:hasGlobalOption a owl:ObjectProperty ;
    rdfs:comment "An option every command of the program accepts." ;
    rdfs:domain tf:CommandLineProgram ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "has global option" ;
    rdfs:range tf:GlobalOption ;
    tf:module "cli" .

tf:hasOption a owl:ObjectProperty ;
    rdfs:comment "An input option of a command." ;
    rdfs:domain tf:CliCommand ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "has option" ;
    rdfs:range tf:CliOption ;
    tf:module "cli" .

tf:hasSideEffect a owl:ObjectProperty ;
    rdfs:comment "What running the command changes." ;
    rdfs:domain tf:CliCommand ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "has side effect" ;
    rdfs:range tf:SideEffect ;
    tf:module "cli" .

tf:idempotent a owl:DatatypeProperty ;
    rdfs:comment "True when repeating the command with the same input has no further effect." ;
    rdfs:domain tf:CliCommand ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "idempotent" ;
    rdfs:range xsd:boolean ;
    tf:module "cli" .

tf:inCommandGroup a owl:ObjectProperty ;
    rdfs:comment "The group a command belongs to." ;
    rdfs:domain tf:CliCommand ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "in command group" ;
    rdfs:range tf:CliCommandGroup ;
    tf:module "cli" .

tf:inputSchema a owl:DatatypeProperty ;
    rdfs:comment "JSON Schema of the command's input object." ;
    rdfs:domain tf:CliCommand ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "input schema" ;
    rdfs:range rdf:JSON ;
    tf:module "cli" .

tf:invokesTool a owl:ObjectProperty ;
    rdfs:comment "The server tool a remote command calls." ;
    rdfs:domain tf:RemoteCliCommand ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "invokes tool" ;
    rdfs:range tf:Tool ;
    tf:module "cli" .

tf:mayExitWith a owl:ObjectProperty ;
    rdfs:comment "An exit status the command can end with." ;
    rdfs:domain tf:CliCommand ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "may exit with" ;
    rdfs:range tf:ExitStatus ;
    tf:module "cli" .

tf:optionFlag a owl:DatatypeProperty ;
    rdfs:comment "The long flag, without dashes." ;
    rdfs:domain tf:CliOption ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "option flag" ;
    rdfs:range xsd:string ;
    tf:module "cli" .

tf:output-json a tf:OutputFormat ;
    skos:definition "One JSON document (the default when stdout is not a terminal)." ;
    skos:inScheme tf:OutputFormatScheme ;
    skos:prefLabel "json" .

tf:output-ndjson a tf:OutputFormat ;
    skos:definition "One JSON object per line: list results are streamed element by element." ;
    skos:inScheme tf:OutputFormatScheme ;
    skos:prefLabel "ndjson" .

tf:output-text a tf:OutputFormat ;
    skos:definition "Human-readable summary (the default on a terminal)." ;
    skos:inScheme tf:OutputFormatScheme ;
    skos:prefLabel "text" .

tf:readsEnvironment a owl:ObjectProperty ;
    rdfs:comment "An environment variable the program or option reads." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "reads environment" ;
    rdfs:range tf:EnvironmentVariable ;
    tf:module "cli" .

tf:requiresCredential a owl:ObjectProperty ;
    rdfs:comment "The credential the command needs." ;
    rdfs:domain tf:CliCommand ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "requires credential" ;
    rdfs:range tf:CredentialRequirement ;
    tf:module "cli" .

tf:retryable a owl:DatatypeProperty ;
    rdfs:comment "True when retrying later can succeed." ;
    rdfs:domain tf:ExitStatus ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "retryable" ;
    rdfs:range xsd:boolean ;
    tf:module "cli" .

tf:returnsType a owl:ObjectProperty ;
    rdfs:comment "The TerraFabric class of the command's result." ;
    rdfs:domain tf:CliCommand ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "returns type" ;
    rdfs:range rdfs:Class ;
    tf:module "cli" .

tf:secret a owl:DatatypeProperty ;
    rdfs:comment "True when the value is a credential: never echoed; pass as env:NAME or file:PATH." ;
    rdfs:domain tf:CliOption ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "secret" ;
    rdfs:range xsd:boolean ;
    tf:module "cli" .

tf:supportsFormat a owl:ObjectProperty ;
    rdfs:comment "An output format the program can write." ;
    rdfs:domain tf:CommandLineProgram ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "supports format" ;
    rdfs:range tf:OutputFormat ;
    tf:module "cli" .

tf:usesNetwork a owl:DatatypeProperty ;
    rdfs:comment "True when the command contacts the server." ;
    rdfs:domain tf:CliCommand ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "uses network" ;
    rdfs:range xsd:boolean ;
    tf:module "cli" .

tf:valueType a owl:ObjectProperty ;
    rdfs:comment "Datatype of an option's value (rdf:JSON for structured values)." ;
    rdfs:domain tf:CliOption ;
    rdfs:isDefinedBy <https://terrafabric.world/ont/cli> ;
    rdfs:label "value type" ;
    rdfs:range rdfs:Datatype ;
    tf:module "cli" .

<https://terrafabric.world/id/cli/tfab> a tf:CommandLineProgram ;
    schema:applicationCategory "DeveloperApplication" ;
    schema:description "tfab: agent-first command line for TerraFabric, the agentic geospatial intelligence market (discovery, pricing, orders, C2 tasking and OSINT), with a self-describing ontology and an MCP server" ;
    schema:isPartOf <https://terrafabric.world/> ;
    schema:name "tfab" ;
    schema:softwareVersion "0.1.2" ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/collections-search> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/collections-get> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/items-search> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/providers-list> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/ontology-describe> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/ontology-term> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/graph-match> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/quotes-create> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/mandates-set> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/orders-place> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/orders-get> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/orders-approve> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/c2-coverage> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/c2-task> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/c2-status> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/osint-sources> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/osint-assess> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/osint-watch-create> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/osint-watch-get> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/graph-sparql> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/passes-predict> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/describe> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/tools> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/schema> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/guide> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/exit-codes> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/doctor> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/config> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/call> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/mcp> ;
    tf:hasCommand <https://terrafabric.world/id/cli/tfab/command/completions> ;
    tf:hasCommandGroup <https://terrafabric.world/id/cli/tfab/group/collections> ;
    tf:hasCommandGroup <https://terrafabric.world/id/cli/tfab/group/items> ;
    tf:hasCommandGroup <https://terrafabric.world/id/cli/tfab/group/passes> ;
    tf:hasCommandGroup <https://terrafabric.world/id/cli/tfab/group/providers> ;
    tf:hasCommandGroup <https://terrafabric.world/id/cli/tfab/group/ontology> ;
    tf:hasCommandGroup <https://terrafabric.world/id/cli/tfab/group/graph> ;
    tf:hasCommandGroup <https://terrafabric.world/id/cli/tfab/group/quotes> ;
    tf:hasCommandGroup <https://terrafabric.world/id/cli/tfab/group/mandates> ;
    tf:hasCommandGroup <https://terrafabric.world/id/cli/tfab/group/orders> ;
    tf:hasCommandGroup <https://terrafabric.world/id/cli/tfab/group/c2> ;
    tf:hasCommandGroup <https://terrafabric.world/id/cli/tfab/group/osint> ;
    tf:hasGlobalOption <https://terrafabric.world/id/cli/tfab/option/base-url> ;
    tf:hasGlobalOption <https://terrafabric.world/id/cli/tfab/option/format> ;
    tf:hasGlobalOption <https://terrafabric.world/id/cli/tfab/option/agent-id> ;
    tf:hasGlobalOption <https://terrafabric.world/id/cli/tfab/option/input> ;
    tf:hasGlobalOption <https://terrafabric.world/id/cli/tfab/option/dry-run> ;
    tf:hasGlobalOption <https://terrafabric.world/id/cli/tfab/option/yes> ;
    tf:hasGlobalOption <https://terrafabric.world/id/cli/tfab/option/timeout> ;
    tf:readsEnvironment <https://terrafabric.world/id/cli/tfab/env/TFAB_TOKEN> ;
    tf:readsEnvironment <https://terrafabric.world/id/cli/tfab/env/TFAB_OAUTH_TOKEN_URL> ;
    tf:readsEnvironment <https://terrafabric.world/id/cli/tfab/env/TFAB_OAUTH_CLIENT_ID> ;
    tf:readsEnvironment <https://terrafabric.world/id/cli/tfab/env/TFAB_OAUTH_CLIENT_SECRET> ;
    tf:readsEnvironment <https://terrafabric.world/id/cli/tfab/env/TFAB_OAUTH_SCOPES> ;
    tf:readsEnvironment <https://terrafabric.world/id/cli/tfab/env/TFAB_MCP_ALLOW_SPEND> ;
    tf:readsEnvironment <https://terrafabric.world/id/cli/tfab/env/TFAB_BASE_URL> ;
    tf:readsEnvironment <https://terrafabric.world/id/cli/tfab/env/TFAB_FORMAT> ;
    tf:readsEnvironment <https://terrafabric.world/id/cli/tfab/env/TFAB_AGENT_ID> ;
    tf:readsEnvironment <https://terrafabric.world/id/cli/tfab/env/TFAB_TIMEOUT> ;
    tf:supportsFormat tf:output-json ;
    tf:supportsFormat tf:output-ndjson ;
    tf:supportsFormat tf:output-text .

<https://terrafabric.world/id/cli/tfab/command/c2-coverage> a tf:RemoteCliCommand ;
    schema:description "Given an AOI, time window and constraints, rank every source (free archive, commercial archive, tasking) by expected collections, time-to-first-data, resolution and cost, and propose a layered collection plan." ;
    schema:encodingType "application/json" ;
    schema:name "Assess coverage for a requirement (C2)" ;
    tf:commandLine "tfab c2 coverage" ;
    tf:example "tfab c2 coverage --input requirement.json" ;
    tf:example "tfab c2 coverage --aoi 4.0,51.9,4.3,52.0 --intent 'port activity'" ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/c2-coverage/option/aoi> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/c2-coverage/option/all-weather> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/c2-coverage/option/budget-usd> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/c2-coverage/option/end> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/c2-coverage/option/include-commercial> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/c2-coverage/option/include-free> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/c2-coverage/option/intent> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/c2-coverage/option/license-tier> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/c2-coverage/option/max-gsd-m> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/c2-coverage/option/max-latency-hours> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/c2-coverage/option/modalities> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/c2-coverage/option/night> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/c2-coverage/option/start> ;
    tf:hasSideEffect tf:effect-read-only ;
    tf:idempotent true ;
    tf:inCommandGroup <https://terrafabric.world/id/cli/tfab/group/c2> ;
