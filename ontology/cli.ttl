<https://terrafabric.world/id/cli/tfab/command/mandates-set> a tf:RemoteCliCommand ;
    schema:description "Principal-issued spending policy for an agent: per-order limit, total budget and permitted licence tiers. Orders outside the mandate wait for approval. Issuing returns a principal_token once; changing an existing mandate requires it. An agent cannot issue its own mandate." ;
    schema:encodingType "application/json" ;
    schema:name "Set agent spending mandate" ;
    tf:commandLine "tfab mandates set" ;
    tf:example "tfab mandates set --agent-id analyst-bot --principal ops-lead --max-order-usd 500 --budget-usd 5000" ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/mandates-set/option/agent-id> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/mandates-set/option/budget-usd> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/mandates-set/option/max-order-usd> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/mandates-set/option/principal> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/mandates-set/option/allowed-license-tiers> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/mandates-set/option/principal-token> ;
    tf:hasSideEffect tf:effect-creates-state ;
    tf:idempotent true ;
    tf:inCommandGroup <https://terrafabric.world/id/cli/tfab/group/mandates> ;
    tf:inputSchema "{\"properties\":{\"agent_id\":{\"type\":\"string\"},\"allowed_license_tiers\":{\"items\":{\"enum\":[\"single-org\",\"multi-org\",\"government-wide\",\"public-release\"],\"type\":\"string\"},\"type\":\"array\"},\"budget_usd\":{\"minimum\":0,\"type\":\"number\"},\"max_order_usd\":{\"minimum\":0,\"type\":\"number\"},\"principal\":{\"type\":\"string\"},\"principal_token\":{\"description\":\"Required to change an existing mandate.\",\"type\":\"string\"}},\"required\":[\"agent_id\",\"principal\",\"max_order_usd\",\"budget_usd\"],\"type\":\"object\"}"^^rdf:JSON ;
    tf:invokesTool <https://terrafabric.world/id/tool/set_mandate> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/ok> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/internal> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/usage> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/not-found> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/auth> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/conflict> ;
