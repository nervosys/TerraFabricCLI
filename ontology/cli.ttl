<https://terrafabric.world/id/cli/tfab/command/collections-search> a tf:RemoteCliCommand ;
    schema:description "Search the TerraFabric catalog of open, commercial and government-channel geospatial intelligence sources: Earth observation (raw to finished products), aircraft and vessel tracks, RF, cellular and network data, weather and forecasts, mobility and events, infrastructure, industry, energy, minerals, AI and the defense industrial base, trade, logistics, capital flows and markets. Supports free text with operational synonyms (e.g. 'radar', 'ship', 'methane'), facets and spatial/temporal filters. access=restricted lists government-only sources (discoverable, never orderable). Returns ranked collections with facet counts." ;
    schema:encodingType "application/json" ;
    schema:name "Search EO collections" ;
    tf:commandLine "tfab collections search" ;
    tf:example "tfab collections search --q radar --bbox 4.0,51.9,4.3,52.0 --limit 5" ;
    tf:example "tfab collections search --modality sar --access free --all-weather" ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/collections-search/option/access> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/collections-search/option/all-weather> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/collections-search/option/bbox> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/collections-search/option/datetime> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/collections-search/option/limit> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/collections-search/option/max-gsd> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/collections-search/option/modality> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/collections-search/option/night> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/collections-search/option/provider> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/collections-search/option/q> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/collections-search/option/sort> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/collections-search/option/tasking> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/collections-search/option/tier> ;
    tf:hasSideEffect tf:effect-read-only ;
    tf:idempotent true ;
    tf:inCommandGroup <https://terrafabric.world/id/cli/tfab/group/collections> ;
    tf:inputSchema "{\"properties\":{\"access\":{\"enum\":[\"free\",\"commercial\",\"restricted\"],\"type\":\"string\"},\"all_weather\":{\"type\":\"boolean\"},\"bbox\":{\"items\":{\"type\":\"number\"},\"maxItems\":4,\"minItems\":4,\"type\":\"array\"},\"datetime\":{\"description\":\"ISO interval 'start/end'; '..' for open ends.\",\"type\":\"string\"},\"limit\":{\"default\":10,\"maximum\":100,\"minimum\":1,\"type\":\"integer\"},\"max_gsd\":{\"description\":\"Max ground sample distance in metres.\",\"type\":\"number\"},\"modality\":{\"items\":{\"enum\":[\"optical\",\"multispectral\",\"hyperspectral\",\"thermal\",\"sar\",\"lidar\",\"elevation\",\"atmospheric\",\"landcover\",\"rf\",\"ais\",\"video\",\"3d\",\"vector\",\"adsb\",\"weather-station\",\"ocean-in-situ\",\"nwp\",\"network\",\"cellular\",\"wardriving\",\"mobility\",\"trade\",\"logistics\",\"installations\",\"events\",\"finance\",\"markets\",\"minerals\",\"industry\",\"energy\",\"ai-compute\",\"robotics\",\"defense-industry\"],\"type\":\"string\"},\"type\":\"array\"},\"night\":{\"type\":\"boolean\"},\"provider\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"q\":{\"description\":\"Free text query.\",\"type\":\"string\"},\"sort\":{\"enum\":[\"relevance\",\"gsd\",\"revisit\",\"latency\",\"price\",\"start\"],\"type\":\"string\"},\"tasking\":{\"description\":\"Only taskable sources.\",\"type\":\"boolean\"},\"tier\":{\"items\":{\"enum\":[\"raw\",\"preprocessed\",\"product\"],\"type\":\"string\"},\"type\":\"array\"}},\"type\":\"object\"}"^^rdf:JSON ;
    tf:invokesTool <https://terrafabric.world/id/tool/search_collections> ;
