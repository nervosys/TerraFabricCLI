    tf:hasSideEffect tf:effect-read-only ;
    tf:idempotent true ;
    tf:inCommandGroup <https://terrafabric.world/id/cli/tfab/group/graph> ;
    tf:inputSchema "{\"properties\":{\"query\":{\"maxLength\":10240,\"type\":\"string\"}},\"required\":[\"query\"],\"type\":\"object\"}"^^rdf:JSON ;
    tf:invokesTool <https://terrafabric.world/id/tool/sparql_query> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/ok> ;
