<https://terrafabric.world/id/cli/tfab/command/quotes-create> a tf:RemoteCliCommand ;
    schema:description "Price a data acquisition. Open data returns a $0 quote. Commercial data is priced by area × rate with minimum area, licence tier uplift and (for tasking) priority uplift. Quotes are valid for 24h." ;
