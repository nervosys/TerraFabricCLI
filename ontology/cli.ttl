<https://terrafabric.world/id/cli/tfab/command/passes-predict> a tf:RemoteCliCommand ;
    schema:description "When will this collection's satellites next pass over an area? SGP4 propagation of public orbital elements for the open constellations (Sentinel-1/2/3/5P, Landsat, MODIS, VIIRS, ICESat-2, ISS instruments, NISAR). Optical collections mark night passes unusable. Geometry only: not every pass is imaged and cloud is not modelled. Window defaults to the next 7 days, max 14." ;
    schema:encodingType "application/json" ;
    schema:name "Predict satellite passes over an AOI" ;
    tf:commandLine "tfab passes predict" ;
    tf:example "tfab passes predict --collection sentinel-1-grd --bbox 4.0,51.9,4.3,52.0" ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/passes-predict/option/bbox> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/passes-predict/option/collection> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/passes-predict/option/end> ;
    tf:hasOption <https://terrafabric.world/id/cli/tfab/command/passes-predict/option/start> ;
    tf:hasSideEffect tf:effect-read-only ;
    tf:idempotent true ;
    tf:inCommandGroup <https://terrafabric.world/id/cli/tfab/group/passes> ;
    tf:inputSchema "{\"properties\":{\"bbox\":{\"items\":{\"type\":\"number\"},\"maxItems\":4,\"minItems\":4,\"type\":\"array\"},\"collection\":{\"type\":\"string\"},\"end\":{\"format\":\"date-time\",\"type\":\"string\"},\"start\":{\"format\":\"date-time\",\"type\":\"string\"}},\"required\":[\"collection\",\"bbox\"],\"type\":\"object\"}"^^rdf:JSON ;
    tf:invokesTool <https://terrafabric.world/id/tool/predict_passes> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/ok> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/internal> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/usage> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/not-found> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/rate-limited> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/unavailable> ;
    tf:mayExitWith <https://terrafabric.world/id/cli/tfab/exit/invalid-input> ;
    tf:requiresCredential tf:credential-none ;
    tf:returnsType tf:Satellite ;
    tf:usesNetwork true .

